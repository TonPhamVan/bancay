* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Preserve the byte-identical original user Master Plan.
/docs/master-plan.md -text whitespace=cr-at-eol,-blank-at-eof

# Preserve original request/license bytes, including their upstream whitespace.
/docs/phase-3/request.md -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
/resources/fonts/OFL.txt -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
/public/storefront/Lora-OFL.txt -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/risk-review/request.md -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/phase-4/request.md -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
