APP_NAME=bancay
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bancay.vn
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
# Keep false until Phase6 deployment gates and origin checks pass.
STOREFRONT_INDEXABLE=false
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_COOKIE=bancay_production_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Replace with verified SMTP only during an approved Phase6 release.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=bancay
EXMENT_MAIL_SETTING_ENV_FORCE=true
EXMENT_OUTSIDE_API=false
EXMENT_LOCALE=en
LEGACY_MIGRATION_ENABLED=false
