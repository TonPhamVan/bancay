# Local configuration and secrets
/.env
/.env.*
!/.env.example
!/.env.production.example
/auth.json

# Private legacy inputs and backups; store original artifacts outside Git.
/backups/
/legacy-private/
*.sql
*.sql.gz
*.sql.bz2
*.sql.xz
*.dump
!/docs/phase-0/evidence/legacy-schema.sql

# Local Python audit caches
__pycache__/
*.pyc

# Laravel runtime / installed dependencies
/vendor/
/node_modules/
/public/vendor/
/public/storage
/public/build/
/resources/views/vendor/
/.phpunit.cache/
/.phpunit.result.cache
/storage/*.key
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*.php
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
!/storage/framework/**/.gitignore
/.composer-cache/

# Exment-published assets/translations are regenerated by the setup command.
/public/font/
/public/lib/
/public/images/
/resources/lang/
